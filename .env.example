# Server-only Neon PostgreSQL connection string. Use the pooled host for app runtime.
DATABASE_URL=

# Managed Neon Auth URLs from the selected Neon branch.
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=

# Public Auth URL used by the Vite browser client (same value as NEON_AUTH_BASE_URL).
VITE_NEON_AUTH_URL=

# First administrator email. Server-only Vercel variable; never prefix with VITE_.
LAMA_MARKET_ADMIN_EMAIL=

# Les paiements mobiles restent désactivés jusqu'à l'intégration directe des API officielles.

APP_URL=https://lama-market.vercel.app

# E-mails transactionnels (notifications de commande et de livraison).
RESEND_API_KEY=
LAMA_MARKET_FROM_EMAIL=

# Neon Object Storage (product-images bucket, public_read)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
