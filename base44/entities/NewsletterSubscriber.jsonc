{
  "name": "NewsletterSubscriber",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "Adresse e-mail inscrite à la newsletter"
    },
    "source": {
      "type": "string",
      "description": "Origine de l'inscription (footer, page d'accueil…)"
    }
  },
  "required": [
    "email"
  ],
  "rls": {
